{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start",
      "startServerReadyPattern": "Ready in|started server on|Local:",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/work",
        "http://localhost:3000/work/uttaranchal-kesari",
        "http://localhost:3000/services/ai-llm-engineering",
        "http://localhost:3000/faq",
        "http://localhost:3000/blog/rag-that-refuses-to-answer",
        "http://localhost:3000/contact"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "skipAudits": ["uses-http2", "canonical", "is-crawlable"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }],

        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],

        "meta-description": "error",
        "document-title": "error",
        "heading-order": "error",
        "image-alt": "error",
        "link-name": "error",
        "color-contrast": "error",
        "html-has-lang": "error",

        "unused-javascript": "off",
        "legacy-javascript": "off",
        "uses-long-cache-ttl": "off",
        "csp-xss": "off"
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
