# ---------------------------------------------------------------------------
# Code Hippies — environment configuration
#
# Copy to .env.local for local work, or paste into Vercel → Settings →
# Environment Variables for production.
#
# EVERYTHING HERE IS OPTIONAL. The site builds and runs with none of it set:
# unconfigured contact channels are hidden rather than broken, the assistant
# answers extractively, and the contact form logs briefs server-side.
#
# Anything prefixed NEXT_PUBLIC_ is compiled into the browser bundle and is
# therefore PUBLIC. Never put a secret behind that prefix — CI greps the built
# client bundle for secret-shaped strings and fails the build if it finds any.
# ---------------------------------------------------------------------------

# === Site identity =========================================================

# Canonical origin. Drives canonical URLs, sitemap.xml, robots.txt, the RSS
# feed and every generated OG image. MUST match the real domain in production.
NEXT_PUBLIC_SITE_URL="https://codehippies.com"


# === Contact channels ======================================================
# Each one appears in the floating dock, the footer and the contact page the
# moment it is set. Unset channels do not render at all.

# International format, digits only. No +, no spaces, no dashes.
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Handle without the @. Produces both a DM link (ig.me) and a profile link.
NEXT_PUBLIC_INSTAGRAM_HANDLE=""
# Optional: a full Instagram DM URL, if you would rather use your own.
NEXT_PUBLIC_INSTAGRAM_DM_URL=""

# Facebook page username or numeric id — becomes m.me/<id>.
NEXT_PUBLIC_MESSENGER_ID=""
# Page username or a full URL.
NEXT_PUBLIC_FACEBOOK_PAGE=""

# Telegram handle without the @.
NEXT_PUBLIC_TELEGRAM_HANDLE=""

NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_PHONE_NUMBER=""
NEXT_PUBLIC_LINKEDIN_URL=""

# Cal.com handle ("deepak/discovery") or a full booking URL. Empty renders an
# honest placeholder instead of a dead booking button.
NEXT_PUBLIC_CAL_LINK=""


# === Freelance marketplaces ================================================
# Full profile URLs. Shown on /hire as the escrow-protected route.

NEXT_PUBLIC_FIVERR_URL=""
NEXT_PUBLIC_UPWORK_URL=""
NEXT_PUBLIC_FREELANCER_URL=""
NEXT_PUBLIC_TOPTAL_URL=""
NEXT_PUBLIC_CLUTCH_URL=""


# === Brand assets ==========================================================
# See public/BRAND-ASSETS.md. Set to "true" once you have replaced the
# corresponding placeholder file.

NEXT_PUBLIC_HAS_CUSTOM_LOGO="false"
NEXT_PUBLIC_HAS_PORTRAIT="false"
NEXT_PUBLIC_HAS_OG_IMAGE="false"


# === Partnership ===========================================================

NEXT_PUBLIC_DHARMARTHLABS_URL="https://dharmarthlabs.com"


# === Server-only secrets ===================================================
# Never prefixed NEXT_PUBLIC_. These never reach the browser.

# Where contact-form briefs are delivered (Slack, Discord, Zapier, a CRM).
# Without it, briefs are logged server-side rather than silently discarded —
# but set this before taking real traffic.
LEAD_WEBHOOK_URL=""

# Anthropic API key for the assistant's generation step. Without it the
# assistant still works and is still strictly grounded, just less fluent.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Dharmarthlabs CMS link (docs/CMS-INTEGRATION.md) ---
# Shared HMAC secret. Until this is set, the CMS endpoint rejects EVERY
# request — a fresh deploy is never accidentally controllable.
#   openssl rand -hex 32
CMS_SHARED_SECRET=""

# Where consented analytics are forwarded, signed with the secret above.
CMS_TELEMETRY_URL=""

# --- Search distribution (DEPLOY.md §5) ---
# Protects /api/indexnow so only the scheduled job can trigger submissions.
#   openssl rand -hex 32
CRON_SECRET=""

# IndexNow key. Served at /<key>.txt to prove domain control.
#   openssl rand -hex 16
INDEXNOW_KEY=""

# Optional. Only raises the GitHub API rate limit for live stats on /about.
# A fine-grained token with NO scopes is sufficient — the endpoints are public.
GITHUB_TOKEN=""
