# ---------------------------------------------------------------------------
# Code Hippies — environment configuration
#
# Copy to .env.local and fill in. Never commit .env.local.
# Anything prefixed NEXT_PUBLIC_ is compiled into the browser bundle and is
# therefore PUBLIC — never put a secret behind that prefix.
# ---------------------------------------------------------------------------

# --- Public (safe to expose; shipped in the client bundle) -----------------

# Canonical origin. Drives canonical URLs, sitemap.xml, robots.txt and OG images.
NEXT_PUBLIC_SITE_URL="https://codehippies.com"

# WhatsApp number in international format, digits only, no + or spaces.
# REQUIRED before launch — the default is a placeholder that does not dial.
NEXT_PUBLIC_WHATSAPP_NUMBER="910000000000"

# Public contact address shown in the footer and on /contact.
NEXT_PUBLIC_CONTACT_EMAIL="hello@codehippies.com"

# Cal.com handle, e.g. "deepak-joshi/discovery". Leave empty and the booking
# card renders an honest placeholder instead of a broken link.
NEXT_PUBLIC_CAL_LINK=""

# --- Server-only secrets (never prefixed NEXT_PUBLIC_) ---------------------

# Anthropic API key for the AI assistant's generation step. Without it the
# assistant still works: it falls back to an extractive answer built from the
# same retrieved chunks, so it is never ungrounded, only less fluent.
ANTHROPIC_API_KEY=""

# Optional model override for the assistant.
ANTHROPIC_MODEL="claude-sonnet-5"

# Where contact-form submissions are delivered (Slack/Discord/Zapier/CRM).
# Without it, briefs are logged server-side rather than silently discarded.
LEAD_WEBHOOK_URL=""

# Optional GitHub token, only to raise the API rate limit for the live stats
# on /about. A fine-grained token with NO scopes is sufficient — the endpoints
# used are public. The page degrades gracefully without it.
GITHUB_TOKEN=""
